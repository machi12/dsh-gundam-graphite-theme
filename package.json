{
  "name": "dsh-gundam-graphite-theme",
  "version": "1.0.1",
  "description": "高达·石墨：DSH Desktop 黑灰壁纸皮肤，含流体粒子与鼠标弹性网络。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-theme", "@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-ui-settings-general", "@deepseek-ai/dsh-client-ui-settings"],
      "platform": "web"
    }
  },
  "files": ["lib", "assets", "cordis.patch.yml", "dsh.plugin.json", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test"
  },
  "dependencies": { "@deepseek-ai/schemastery": "^3.18.2" },
  "repository": { "type": "git", "url": "git+https://github.com/machi12/dsh-gundam-graphite-theme.git" },
  "homepage": "https://github.com/machi12/dsh-gundam-graphite-theme#readme",
  "bugs": { "url": "https://github.com/machi12/dsh-gundam-graphite-theme/issues" },
  "license": "MIT",
  "keywords": ["dsh", "deepseek-harness", "dsh-plugin", "dsh-theme", "gundam"]
}
